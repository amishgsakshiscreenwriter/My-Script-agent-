        <div class="contact-role">${c.role} ${c.company ? '· ' + c.company : ''}</div>
        <div class="contact-source">${c.source}</div>
      </div>
      <span class="badge badge-${c.status}">${c.status === 'pending' ? 'Pending' : c.status === 'sent' ? 'Sent' : 'Replied'}</span>
    </div>
  `).join('');
}

function getEmoji(role) {
