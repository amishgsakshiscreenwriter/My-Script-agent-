  const m = document.getElementById(msgId);
  if(m) m.textContent = msg;
  if(el) { el.classList.add('show'); setTimeout(() => el.classList.remove('show'), 5000); }
}

// ===== INIT =====
loadSetup();
renderContacts();
updateStats();
</script>
