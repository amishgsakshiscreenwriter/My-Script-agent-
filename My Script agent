// ===== GENERATE PITCH =====
async function generatePitch() {
  const title = document.getElementById('s-title').value.trim();
  const genre = document.getElementById('s-genre').value;
  const logline = document.getElementById('s-logline').value.trim();
  const treatment = document.getElementById('s-treatment').value.trim();
  const usp = document.getElementById('s-usp').value.trim();
  const geminiKey = document.getElementById('set-gemini').value.trim() || USER.gemini;

  if(!title || !logline) { showError('pitch-error','pitch-error-msg','Script का नाम और Logline जरूर भरें'); return; }
  if(!geminiKey) { showError('pitch-error','pitch-error-msg','Setup tab में Gemini API Key डालें'); return; }

  const mktText = market==='both' ? 'Bollywood and Hollywood' : market==='bol' ? 'Bollywood' : 'Hollywood';
  const toneText = tone==='pro' ? 'professional and formal' : tone==='per' ? 'personal and warm' : 'bold and confident';

  document.getElementById('gen-btn').disabled = true;
  document.getElementById('pitch-loading').classList.add('show');
  document.getElementById('pitch-result').classList.remove('show');
  document.getElementById('pitch-actions').style.display = 'none';

  const prompt = `You are an expert script pitch writer for the film industry. Write a compelling pitch email for this screenplay.

Script Title: ${title}
Genre: ${genre}
Logline: ${logline}
${treatment ? 'Synopsis: ' + treatment : ''}
${usp ? 'Unique Points: ' + usp : ''}
Target: ${mktText}
Tone: ${toneText}
Sender: ${USER.name} (${USER.email})

Write a pitch email (150-200 words) that:
- Starts with "Dear [Name],"
- Opens with a strong hook
- States the logline clearly  
- Highlights commercial viability
- Mentions WGA registration and Indian Copyright registration
- Has a clear call to action
- Ends before the signature (I will add signature separately)
- Sounds completely human, NOT like AI

Write ONLY the email body. No subject line.`;

  try {
    const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiKey}`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({contents:[{parts:[{text: prompt}]}]})
    });
    const data = await res.json();

    if(data.error) throw new Error(data.error.message);

    const text = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
    generatedPitch = text + '\n\n' + USER.sig;

    document.getElementById('pitch-result').textContent = generatedPitch;
    document.getElementById('pitch-result').classList.add('show');
    document.getElementById('pitch-actions').style.display = 'block';

  } catch(err) {
    showError('pitch-error','pitch-error-msg', 'Error: ' + err.message);
  }

  document.getElementById('pitch-loading').classList.remove('show');
  document.getElementById('gen-btn').disabled = false;
}

// ===== SEND EMAILS =====
async function sendPitchEmails() {
  const selected = contacts.filter(c => c.selected);
  if(selected.length === 0) { showError('pitch-error','pitch-error-msg','Contacts tab में contacts select करें'); return; }
  if(!generatedPitch) { showError('pitch-error','pitch-error-msg','पहले Pitch Letter बनाएं'); return; }

  const title = document.getElementById('s-title').value.trim();
  const gmailPass = document.getElementById('set-gmailpass').value.trim() || USER.gmailpass;

  if(!gmailPass) {
    showError('pitch-error','pitch-error-msg','Setup tab में Gmail App Password डालें — Real email के लिए जरूरी है');
    return;
  }

  showNotif('pitch-notif','pitch-notif-msg', selected.length + ' contacts को email भेजी जा रही है...');

  // EmailJS या direct SMTP के बिना browser से direct email नहीं जा सकती
  // इसलिए Gmail draft खोलते हैं
  for(const c of selected) {
    const subject = encodeURIComponent(`Script Pitch: ${title} — ${USER.name}`);
    const body = encodeURIComponent(generatedPitch.replace('Dear [Name],', `Dear ${c.name},`));
    const gmailURL = `https://mail.google.com/mail/?view=cm&to=${encodeURIComponent(c.email)}&su=${subject}&body=${body}`;
    window.open(gmailURL, '_blank');
    c.status = 'sent';
    stats.sent++;
    await new Promise(r => setTimeout(r, 800));
  }

  saveContacts();
  saveStats();
  renderContacts();
  showNotif('pitch-notif','pitch-notif-msg', '✅ ' + selected.length + ' Gmail drafts खुल गए! Review करके Send दबाएं।');
}

