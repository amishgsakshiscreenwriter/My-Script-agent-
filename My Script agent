<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Script Pitch Agent — Amish G Sakshi</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --dark: #0a0a0f;
    --dark2: #111118;
    --dark3: #1a1a24;
    --dark4: #22222f;
    --text: #e8e4d9;
    --text-dim: #8a8578;
    --red: #e05252;
    --green: #52c07a;
    --blue: #5293e0;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    background: var(--dark);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    max-width: 480px;
    margin: 0 auto;
  }

  /* HEADER */
  .header {
    padding: 20px 16px 12px;
    border-bottom: 1px solid rgba(201,168,76,0.15);
    background: linear-gradient(180deg, rgba(201,168,76,0.06) 0%, transparent 100%);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }
  .header-row { display:flex; align-items:center; justify-content:space-between; }
  .logo { display:flex; align-items:center; gap:10px; }
  .logo-icon { width:34px; height:34px; background:linear-gradient(135deg,var(--gold),var(--gold-light)); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:17px; }
  .logo-text { font-family:'Playfair Display',serif; font-size:17px; color:var(--gold); }
  .live-dot { width:8px; height:8px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green); animation:pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1}50%{opacity:0.3} }
  .header-sub { font-size:10px; color:var(--text-dim); letter-spacing:1.5px; text-transform:uppercase; margin-top:3px; }

  /* NAV */
  .nav { display:flex; background:var(--dark2); border-bottom:1px solid rgba(255,255,255,0.05); overflow-x:auto; scrollbar-width:none; position:sticky; top:72px; z-index:99; }
  .nav::-webkit-scrollbar { display:none; }
  .nav-item { flex:1; min-width:65px; padding:10px 4px; text-align:center; font-size:10px; color:var(--text-dim); cursor:pointer; border-bottom:2px solid transparent; transition:all 0.2s; }
  .nav-item.active { color:var(--gold); border-bottom-color:var(--gold); background:rgba(201,168,76,0.04); }
  .nav-icon { font-size:15px; display:block; margin-bottom:2px; }

  /* SCREENS */
  .screen { display:none; padding:16px; padding-bottom:80px; }
  .screen.active { display:block; animation:fadeIn 0.25s ease; }
  @keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

  /* CARDS */
  .card { background:var(--dark3); border:1px solid rgba(255,255,255,0.07); border-radius:12px; padding:14px; margin-bottom:12px; }
  .card-title { font-family:'Playfair Display',serif; font-size:13px; color:var(--gold); margin-bottom:10px; display:flex; align-items:center; gap:7px; }

  /* FORM */
  label { display:block; font-size:10px; color:var(--text-dim); letter-spacing:1px; text-transform:uppercase; margin-bottom:5px; margin-top:10px; }
  label:first-child { margin-top:0; }
  input, textarea, select { width:100%; background:var(--dark4); border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:10px 11px; color:var(--text); font-family:'DM Sans',sans-serif; font-size:13px; outline:none; transition:border-color 0.2s; resize:vertical; }
  input:focus, textarea:focus, select:focus { border-color:rgba(201,168,76,0.4); }
  select option { background:var(--dark3); }
  textarea { min-height:75px; }

  /* BUTTONS */
  .btn { width:100%; padding:12px; border-radius:10px; border:none; font-family:'DM Sans',sans-serif; font-size:13px; font-weight:500; cursor:pointer; transition:all 0.2s; letter-spacing:0.3px; margin-top:8px; }
  .btn-gold { background:linear-gradient(135deg,var(--gold),var(--gold-light)); color:var(--dark); }
  .btn-gold:hover { transform:translateY(-1px); box-shadow:0 4px 18px rgba(201,168,76,0.3); }
  .btn-gold:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
  .btn-outline { background:transparent; color:var(--gold); border:1px solid rgba(201,168,76,0.35); }
  .btn-outline:hover { background:rgba(201,168,76,0.07); }
  .btn-red { background:rgba(224,82,82,0.12); color:var(--red); border:1px solid rgba(224,82,82,0.25); }
  .btn-green { background:rgba(82,192,122,0.12); color:var(--green); border:1px solid rgba(82,192,122,0.25); }

  /* TOGGLE */
  .toggle-group { display:flex; gap:6px; margin-bottom:4px; }
  .toggle-btn { flex:1; padding:9px 6px; border-radius:8px; border:1px solid rgba(255,255,255,0.08); background:var(--dark4); color:var(--text-dim); font-size:11px; cursor:pointer; text-align:center; transition:all 0.2s; }
  .toggle-btn.on { background:rgba(201,168,76,0.12); border-color:rgba(201,168,76,0.4); color:var(--gold); }

  /* RESULT */
  .result-box { background:var(--dark4); border:1px solid rgba(201,168,76,0.2); border-radius:10px; padding:13px; font-size:12px; line-height:1.75; white-space:pre-wrap; color:var(--text); display:none; margin-top:10px; }
  .result-box.show { display:block; animation:fadeIn 0.3s ease; }

  /* LOADING */
  .loading { display:none; text-align:center; padding:22px; color:var(--text-dim); font-size:12px; }
  .loading.show { display:block; }
  .spinner { width:26px; height:26px; border:2px solid rgba(201,168,76,0.15); border-top-color:var(--gold); border-radius:50%; animation:spin 0.75s linear infinite; margin:0 auto 9px; }
  @keyframes spin { to{transform:rotate(360deg)} }

  /* NOTIFICATION */
  .notif { display:none; padding:10px 12px; border-radius:8px; font-size:12px; margin-bottom:10px; align-items:center; gap:8px; }
  .notif.show { display:flex; animation:fadeIn 0.3s ease; }
  .notif-success { background:rgba(82,192,122,0.1); border:1px solid rgba(82,192,122,0.25); color:var(--green); }
  .notif-error { background:rgba(224,82,82,0.1); border:1px solid rgba(224,82,82,0.25); color:var(--red); }
  .notif-info { background:rgba(201,168,76,0.08); border:1px solid rgba(201,168,76,0.2); color:var(--gold); }

  /* INFO BOX */
  .info-box { font-size:11px; color:var(--text-dim); line-height:1.6; padding:9px 11px; background:rgba(201,168,76,0.04); border-left:2px solid rgba(201,168,76,0.3); border-radius:0 6px 6px 0; margin-bottom:10px; }

  /* CONTACTS */
  .contact-card { display:flex; align-items:center; gap:10px; padding:11px; background:var(--dark3); border:1px solid rgba(255,255,255,0.06); border-radius:10px; margin-bottom:7px; }
  .contact-avatar { width:34px; height:34px; border-radius:50%; background:var(--dark4); border:1px solid rgba(201,168,76,0.2); display:flex; align-items:center; justify-content:center; font-size:13px; flex-shrink:0; }
  .contact-info { flex:1; min-width:0; }
  .contact-name { font-size:12px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .contact-role { font-size:10px; color:var(--text-dim); }
  .contact-source { font-size:9px; color:var(--gold); margin-top:1px; }
  .badge { font-size:9px; padding:2px 7px; border-radius:20px; flex-shrink:0; }
  .badge-pending { background:rgba(138,133,120,0.15); color:var(--text-dim); }
  .badge-sent { background:rgba(82,144,224,0.15); color:var(--blue); }
  .badge-replied { background:rgba(82,192,122,0.15); color:var(--green); }

  /* INBOX */
  .inbox-card { background:var(--dark3); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:13px; margin-bottom:8px; cursor:pointer; transition:all 0.2s; position:relative; }
  .inbox-card:hover { border-color:rgba(201,168,76,0.2); }
  .inbox-card.positive { border-left:3px solid var(--green); }
  .inbox-card.important { border-left:3px solid var(--gold); }
  .inbox-card.negative { border-left:3px solid var(--red); }
  .inbox-from { font-size:13px; font-weight:500; margin-bottom:3px; }
  .inbox-subject { font-size:11px; color:var(--text-dim); margin-bottom:5px; }
  .inbox-preview { font-size:10px; color:var(--text-dim); line-height:1.5; }
  .inbox-badge { position:absolute; top:11px; right:11px; font-size:9px; padding:2px 7px; border-radius:20px; }
  .ib-pos { background:rgba(82,192,122,0.15); color:var(--green); }
  .ib-imp { background:rgba(201,168,76,0.15); color:var(--gold); }
  .ib-neg { background:rgba(224,82,82,0.15); color:var(--red); }
  .ib-neu { background:rgba(138,133,120,0.15); color:var(--text-dim); }

  /* STATS */
  .stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:12px; }
  .stat-card { background:var(--dark3); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:13px; text-align:center; }
  .stat-num { font-family:'Playfair Display',serif; font-size:26px; color:var(--gold); display:block; }
  .stat-label { font-size:10px; color:var(--text-dim); margin-top:2px; }

  /* PROGRESS */
  .progress-bar { height:3px; background:rgba(255,255,255,0.05); border-radius:2px; overflow:hidden; margin-top:7px; }
  .progress-fill { height:100%; background:linear-gradient(90deg,var(--gold),var(--gold-light)); border-radius:2px; transition:width 0.5s ease; }

  /* SOURCE GRID */
  .source-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; }
  .source-item { background:var(--dark4); border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:9px; cursor:pointer; transition:all 0.2s; display:flex; align-items:center; gap:7px; }
  .source-item.on { background:rgba(201,168,76,0.1); border-color:rgba(201,168,76,0.35); }
  .source-check { width:15px; height:15px; border-radius:3px; border:1.5px solid var(--text-dim); display:flex; align-items:center; justify-content:center; font-size:9px; flex-shrink:0; transition:all 0.2s; }
  .source-item.on .source-check { background:var(--gold); border-color:var(--gold); color:var(--dark); }
  .source-name { font-size:11px; color:var(--text-dim); }
  .source-item.on .source-name { color:var(--text); }

  /* FILE UPLOAD */
  .file-upload { border:1.5px dashed rgba(201,168,76,0.3); border-radius:10px; padding:18px; text-align:center; cursor:pointer; transition:all 0.2s; background:rgba(201,168,76,0.02); }
  .file-upload:hover { border-color:rgba(201,168,76,0.5); }
  .file-upload-icon { font-size:26px; margin-bottom:6px; }
  .file-upload-text { font-size:12px; color:var(--text-dim); }

  /* MODAL */
  .modal-bg { position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:500; display:none; align-items:flex-end; }
  .modal-bg.show { display:flex; }
  .modal { background:var(--dark2); border-top:1px solid rgba(201,168,76,0.2); border-radius:18px 18px 0 0; padding:18px; width:100%; max-height:88vh; overflow-y:auto; animation:slideUp 0.3s ease; }
  @keyframes slideUp { from{transform:translateY(100%)} to{transform:translateY(0)} }
  .modal-handle { width:34px; height:3px; background:rgba(255,255,255,0.1); border-radius:2px; margin:0 auto 14px; }
  .modal-title { font-family:'Playfair Display',serif; font-size:15px; color:var(--gold); margin-bottom:12px; }
  .modal-close { float:right; background:none; border:none; color:var(--text-dim); font-size:20px; cursor:pointer; margin-top:-4px; }
  .divider { height:1px; background:rgba(255,255,255,0.05); margin:12px 0; }
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="header-row">
    <div class="logo">
      <div class="logo-icon">🎬</div>
      <span class="logo-text">Script Pitch Agent</span>
    </div>
    <div class="live-dot"></div>
  </div>
  <div class="header-sub">Amish G Sakshi · Personal AI Agent</div>
</div>

<!-- NAV -->
<div class="nav">
  <div class="nav-item active" onclick="showTab('pitch',this)"><span class="nav-icon">✍️</span>Pitch</div>
  <div class="nav-item" onclick="showTab('contacts',this)"><span class="nav-icon">🎯</span>Contacts</div>
  <div class="nav-item" onclick="showTab('inbox',this)"><span class="nav-icon">📬</span>Inbox</div>
  <div class="nav-item" onclick="showTab('tracker',this)"><span class="nav-icon">📊</span>Tracker</div>
  <div class="nav-item" onclick="showTab('setup',this)"><span class="nav-icon">⚙️</span>Setup</div>
</div>

<!-- ===== PITCH SCREEN ===== -->
<div class="screen active" id="tab-pitch">

  <div class="notif notif-success" id="pitch-notif"><span>✅</span><span id="pitch-notif-msg"></span></div>
  <div class="notif notif-error" id="pitch-error"><span>⚠️</span><span id="pitch-error-msg"></span></div>

  <!-- Pitch Type -->
  <div class="card">
    <div class="card-title">📋 क्या भेजना है?</div>
    <div class="toggle-group">
      <div class="toggle-btn on" id="mode-safe" onclick="setMode('safe')">
        🔒 Logline / Treatment<br><span style="font-size:9px;opacity:0.7">Script सुरक्षित रहे</span>
      </div>
      <div class="toggle-btn" id="mode-full" onclick="setMode('full')">
        📄 Full Script<br><span style="font-size:9px;opacity:0.7">Complete पिच</span>
      </div>
    </div>
  </div>

  <!-- Safe Mode -->
  <div id="safe-section">
    <div class="card">
      <div class="card-title">✏️ Script Details</div>
      <div class="info-box">💡 Script upload नहीं होगी — सिर्फ idea से pitch बनेगी। Script पूरी तरह सुरक्षित।</div>
      <label>Script का नाम *</label>
      <input type="text" id="s-title" placeholder="जैसे: Hybrid Kingdom" />
      <label>Genre *</label>
      <select id="s-genre">
        <option value="">चुनें...</option>
        <option>Sci-Fi / Fantasy</option>
        <option>Action / Thriller</option>
        <option>Drama</option>
        <option>Comedy</option>
        <option>Horror</option>
        <option>Romance</option>
        <option>Historical / Period</option>
        <option>Biographical</option>
      </select>
      <label>Logline *</label>
      <textarea id="s-logline" placeholder="एक-दो लाइन में पूरी story..."></textarea>
      <label>Treatment / Synopsis (optional)</label>
      <textarea id="s-treatment" placeholder="3-5 lines में story arc..."></textarea>
      <label>यह Script क्यों खास है?</label>
      <textarea id="s-usp" placeholder="जैसे: Hollywood-Bollywood crossover, WGA registered..." style="min-height:55px;"></textarea>
    </div>
  </div>

  <!-- Full Script Mode -->
  <div id="full-section" style="display:none;">
    <div class="card">
      <div class="card-title">📄 Script Upload</div>
      <div class="info-box">⚠️ Upload से पहले copyright registration जरूर करें।</div>
      <div class="file-upload" onclick="document.getElementById('script-file').click()">
        <div class="file-upload-icon">📁</div>
        <div class="file-upload-text" id="file-text">Script PDF / Word चुनें</div>
      </div>
      <input type="file" id="script-file" accept=".pdf,.doc,.docx" style="display:none" onchange="handleFile(this)">
      <label>Script का नाम *</label>
      <input type="text" id="s-title2" placeholder="Hybrid Kingdom" />
      <label>Genre *</label>
      <select id="s-genre2">
        <option value="">चुनें...</option>
        <option>Sci-Fi / Fantasy</option>
        <option>Action / Thriller</option>
        <option>Drama</option>
        <option>Comedy</option>
      </select>
    </div>
  </div>

  <!-- Target -->
  <div class="card">
    <div class="card-title">🌍 Target Market</div>
    <div class="toggle-group">
      <div class="toggle-btn on" id="mkt-both" onclick="setMkt('both')">🌏 Both</div>
      <div class="toggle-btn" id="mkt-bol" onclick="setMkt('bol')">🎥 Bollywood</div>
      <div class="toggle-btn" id="mkt-hol" onclick="setMkt('hol')">🎬 Hollywood</div>
    </div>
  </div>

  <!-- Tone -->
  <div class="card">
    <div class="card-title">🎭 Email Tone</div>
    <div class="toggle-group">
      <div class="toggle-btn on" id="tone-pro" onclick="setTone('pro')">Professional</div>
      <div class="toggle-btn" id="tone-per" onclick="setTone('per')">Personal</div>
      <div class="toggle-btn" id="tone-bold" onclick="setTone('bold')">Bold</div>
    </div>
  </div>

  <!-- Generate -->
  <button class="btn btn-gold" id="gen-btn" onclick="generatePitch()">✨ AI से Pitch Letter बनाएं</button>

  <div class="loading" id="pitch-loading">
    <div class="spinner"></div>
    Gemini AI pitch तैयार कर रहा है...
  </div>

  <div class="result-box" id="pitch-result"></div>

  <div id="pitch-actions" style="display:none;">
    <button class="btn btn-gold" onclick="sendPitchEmails()">📧 Selected Contacts को भेजें</button>
    <button class="btn btn-outline" onclick="copyPitch()">📋 Copy करें</button>
    <button class="btn btn-outline" onclick="generatePitch()">🔄 दोबारा बनाएं</button>
  </div>

</div>

<!-- ===== CONTACTS SCREEN ===== -->
<div class="screen" id="tab-contacts">

  <!-- Sources -->
  <div class="card">
    <div class="card-title">🔍 Contact Sources</div>
    <div class="info-box">जहाँ से contacts ढूंढने हैं वो चुनें।</div>
    <div class="source-grid">
      <div class="source-item on" onclick="toggleSrc(this)"><div class="source-check">✓</div><div><div class="source-name">Apollo.io</div><div style="font-size:9px;color:var(--text-dim)">Industry DB</div></div></div>
      <div class="source-item on" onclick="toggleSrc(this)"><div class="source-check">✓</div><div><div class="source-name">Film Freeway</div><div style="font-size:9px;color:var(--text-dim)">Film Platform</div></div></div>
      <div class="source-item" onclick="toggleSrc(this)"><div class="source-check"></div><div><div class="source-name">IMDb Pro Sheet</div><div style="font-size:9px;color:var(--text-dim)">Excel import</div></div></div>
      <div class="source-item" onclick="toggleSrc(this)"><div class="source-check"></div><div><div class="source-name">LinkedIn Sheet</div><div style="font-size:9px;color:var(--text-dim)">Excel import</div></div></div>
      <div class="source-item" onclick="toggleSrc(this)"><div class="source-check"></div><div><div class="source-name">Hunter.io</div><div style="font-size:9px;color:var(--text-dim)">Email finder</div></div></div>
      <div class="source-item" onclick="toggleSrc(this)"><div class="source-check"></div><div><div class="source-name">The Black List</div><div style="font-size:9px;color:var(--text-dim)">Script platform</div></div></div>
    </div>
  </div>

  <!-- Sheet Import -->
  <div class="card">
    <div class="card-title">📊 Excel / CSV Import</div>
    <div class="info-box">IMDb Pro या LinkedIn से contacts Excel में save करें, फिर यहाँ upload करें।</div>
    <div class="file-upload" onclick="document.getElementById('sheet-file').click()">
      <div class="file-upload-icon">📊</div>
      <div class="file-upload-text" id="sheet-text">Excel / CSV Upload करें</div>
    </div>
    <input type="file" id="sheet-file" accept=".csv,.xlsx,.xls" style="display:none" onchange="handleSheet(this)">
  </div>

  <!-- Manual Add -->
  <div class="card">
    <div class="card-title">➕ Contact जोड़ें</div>
    <label>नाम *</label>
    <input type="text" id="c-name" placeholder="Karan Johar" />
    <label>Email *</label>
    <input type="email" id="c-email" placeholder="submissions@dharma.in" />
    <label>Company</label>
    <input type="text" id="c-company" placeholder="Dharma Productions" />
    <label>Role</label>
    <select id="c-role">
      <option>Producer</option>
      <option>Director</option>
      <option>Studio Executive</option>
      <option>Talent Agent</option>
      <option>Script Manager</option>
    </select>
    <button class="btn btn-gold" onclick="addContact()">+ Contact Add करें</button>
  </div>

  <!-- List -->
  <div style="font-size:12px;color:var(--text-dim);margin-bottom:8px;">
    📋 Contacts: <span id="c-count">0</span> &nbsp;|&nbsp; Selected: <span id="c-selected">0</span>
  </div>
  <div id="contacts-list"></div>

</div>

<!-- ===== INBOX SCREEN ===== -->
<div class="screen" id="tab-inbox">
  <div class="info-box">🤖 AI हर reply पढ़ता है। सिर्फ important replies पर ध्यान दें।</div>

  <div class="toggle-group" style="margin-bottom:12px;">
    <div class="toggle-btn on" onclick="filterInbox(this,'all')" style="flex:none;padding:7px 12px;">All</div>
    <div class="toggle-btn" onclick="filterInbox(this,'positive')" style="flex:none;padding:7px 12px;">✅ Positive</div>
    <div class="toggle-btn" onclick="filterInbox(this,'important')" style="flex:none;padding:7px 12px;">⭐ Important</div>
  </div>

  <div id="inbox-list">
    <div class="inbox-card positive" onclick="openReply('dharma')">
      <span class="inbox-badge ib-pos">✅ Interested</span>
      <div class="inbox-from">Dharma Productions</div>
      <div class="inbox-subject">Re: Script Pitch — Hybrid Kingdom</div>
      <div class="inbox-preview">Thank you for reaching out. We found your concept very interesting...</div>
