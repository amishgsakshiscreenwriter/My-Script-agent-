    return;
  }

  list.innerHTML = contacts.map(c => `
    <div class="contact-card" onclick="toggleContact(${c.id})" style="${c.selected ? 'border-color:rgba(201,168,76,0.4);background:rgba(201,168,76,0.05)' : ''}">
